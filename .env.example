# Production / Vercel: use a pooled PostgreSQL URL (for example Neon pooled connection string).
DATABASE_URL=

# Use a long random secret in Production. Changing it invalidates anonymous game-session cookies.
WEB_SESSION_SECRET=

# Optional: only for disposable production-like demos without PostgreSQL. Never use for real Vercel games.
WEB_ALLOW_MEMORY_DEMO=0
